{
  "name": "storygen-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "11.15.0",
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "25.9.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.6",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "17.0.7",
    "prettier": "3.4.2",
    "typescript": "5.7.2",
    "vitest": "4.1.7"
  },
  "overrides": {
    "postcss": "8.5.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,css,md,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
