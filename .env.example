# Runtime
APP_NAME=StoryGen API
APP_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///./storygen.db
REDIS_URL=redis://redis:6379/0

# Providers: use mock locally; change to gemini/imagen/gcp with Google credentials in production
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
TTS_PROVIDER=mock
SAFETY_PROVIDER=rules
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-1.5-flash
IMAGEN_MODEL=imagen-3.0-generate-002

# Object storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=storygen-assets
STORAGE_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=storygen-local
MINIO_ROOT_PASSWORD=local-development-only

# Controls and feature flags
SESSION_TOKEN_BUDGET=7000
SESSION_IMAGE_BUDGET=8
ANONYMOUS_DAILY_QUOTA=5
SIGNED_URL_TTL_SECONDS=900
ENABLE_TTS=true
ENABLE_EVAL_DASHBOARD=true
ENABLE_PUBLIC_SHARING=true
ENABLE_PDF_EXPORT=true
LOG_JSON=false
ADMIN_KEY=replace-for-production

# Infrastructure deployment
GCP_REGION=us-central1
GCP_PROJECT_ID=your-project-id
BACKEND_IMAGE=us-docker.pkg.dev/your-project-id/storygen/backend:latest
FRONTEND_IMAGE=us-docker.pkg.dev/your-project-id/storygen/frontend:latest
